generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Crew {
  id     String  @id @default(cuid())
  name   String
  color  String
  active Boolean @default(true)
  jobs   Job[]

  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id])
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model Customer {
  id      String  @id @default(cuid())
  name    String
  address String
  phone   String?
  notes   String?
  jobs    Job[]

  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

enum ServiceType {
  MOW
  MULCH
  CLEANUP
  OTHER
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  ONE_TIME
}

enum JobStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
  RESCHEDULED
}

model Job {
  id            String      @id @default(cuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  serviceType   ServiceType
  // Free-text service name, used only when serviceType is OTHER. Displayed in
  // place of the "Other" label everywhere a job's service is shown.
  customService String?
  frequency     Frequency
  crewId        String
  crew          Crew        @relation(fields: [crewId], references: [id])
  scheduledDate DateTime    @db.Date
  orderInDay    Int         @default(0)
  status        JobStatus   @default(SCHEDULED)
  notes         String?

  // Groups occurrences generated from the same recurring job so a series
  // can keep producing future visits without a separate template table.
  // Null for ONE_TIME jobs, which have no series to belong to.
  seriesId String?

  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduledDate])
  @@index([crewId, scheduledDate])
  @@index([customerId])
  @@index([seriesId])
}

enum Role {
  OWNER
  CREW
}

model Org {
  id        String     @id @default(cuid())
  name      String
  // Appears in the crew login URL, e.g. /c/acme-lawn
  slug      String     @unique
  users     User[]
  crews     Crew[]
  customers Customer[]
  jobs      Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  role  Role
  name  String

  // Owner credentials. Null for CREW users.
  email        String? @unique
  passwordHash String?

  // Crew credentials. Null for OWNER users. The username is unique per-org
  // rather than globally, so every company can have its own "jose".
  username String?
  pinHash  String?
  crewId   String?
  crew     Crew?   @relation(fields: [crewId], references: [id])

  active Boolean @default(true)

  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, username])
  @@index([orgId])
}

model Session {
  id String @id @default(cuid())
  // SHA-256 of the cookie token. The raw token is never stored, so a database
  // leak yields no usable session cookies.
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
